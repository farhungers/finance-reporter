# Telegram — filled after @BotFather step (see CLAUDE.md §B.0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM providers — all free tier
GEMINI_API_KEY=                     # generate free at aistudio.google.com
GROQ_API_KEY=                       # optional fallback, free at console.groq.com
CEREBRAS_API_KEY=                   # optional fallback, free at cloud.cerebras.ai (llama-3.3-70b, no 8K TPM cap)
LLM_PROVIDER=gemini                 # 'gemini' (default), 'groq', or 'cerebras'

# Per-report kill switches (operator can silence any report type independently)
KILL_SWITCH_DAILY_MORNING=false
KILL_SWITCH_DAILY_WRAP=false
KILL_SWITCH_WEEKLY_LOOKBACK=false
KILL_SWITCH_WEEKLY_PREP=false

# Global dry-run — when true, reports print to stdout instead of Telegram
DRY_RUN=true
